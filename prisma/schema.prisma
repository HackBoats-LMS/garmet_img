generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockItem {
  id              String      @id @default(cuid())
  stockCode       String      @unique
  title           String
  category        String      @default("saree")
  price           Float?
  mrp             Float?
  rawDescription  String
  status          StockStatus @default(ACTIVE)
  referenceImages Json
  whatsappCopy    String?
  instagramCopy   String?
  websiteCopy     String?
  billedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  poses           StockPose[]

  @@index([stockCode])
  @@index([status])
}

model StockPose {
  id          String    @id @default(cuid())
  stockItemId String
  poseNumber  Int
  poseName    String
  imageUrl    String
  prompt      String
  createdAt   DateTime  @default(now())
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([stockItemId])
  @@index([stockItemId, poseNumber])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  slug          String        @unique
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  products      Product[]
  subCategories SubCategory[]
}

model SubCategory {
  id         String    @id @default(cuid())
  categoryId String
  name       String
  slug       String
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  products   Product[]
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, slug])
  @@index([categoryId])
}

model ProductDesignGroup {
  id                     String    @id @default(cuid())
  designNumber           String    @unique
  title                  String
  description            String?
  coverImageUrl          String?
  color                  String?
  clothType              String?
  embroideryType         String?
  cutStyle               String?
  border                 String?
  kurtaLength            String?
  pantStyle              String?
  tags                   String[]
  whatsappRetail         String?
  whatsappWholesale      String?
  instagramCaption       String?
  facebookCaption        String?
  shopifyTitle           String?
  whatsappCatalogueTitle String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  stockEntries           Product[]

  @@index([designNumber])
}

model Product {
  id                     String              @id @default(cuid())
  stockCode              String              @unique
  code1                  String?             @unique
  productName            String
  productDescription     String?
  color                  String?
  tags                   String[]
  designGroupId          String?
  categoryId             String?
  subCategoryId          String?
  clothType              String?
  quantity               Int                 @default(0)
  reservedQty            Int                 @default(0)
  soldQty                Int                 @default(0)
  status                 ProductStatus       @default(ACTIVE)
  referenceImages        Json?
  generatedImages        Json?
  coverImageUrl          String?
  linkedOrderId          String?
  aspectRatio            String?             @default("3:4")
  captions               Json?
  websiteCopy            String?
  websiteProductId       String?
  syncedAt               DateTime?
  productCode            String?
  length_Size            String?
  location               String?
  embroideryType         String?
  cutStyle               String?
  border                 String?
  kurtaLength            String?
  pantStyle              String?
  whatsappRetail         String?
  whatsappWholesale      String?
  instagramCaption       String?
  facebookCaption        String?
  shopifyTitle           String?
  whatsappCatalogueTitle String?
  customFields           Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  dealerPrice            Float?
  retailPrice            Float?
  unitPrice              Float?
  sizeInventory          Json?
  inventoryLogs          InventoryLog[]
  category               Category?           @relation(fields: [categoryId], references: [id])
  designGroup            ProductDesignGroup? @relation(fields: [designGroupId], references: [id])
  subCategory            SubCategory?        @relation(fields: [subCategoryId], references: [id])

  @@index([stockCode])
  @@index([code1])
  @@index([status])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([designGroupId])
  @@index([productCode])
  @@index([productName])
  @@index([status, categoryId])
  @@index([status, subCategoryId])
  @@index([status, updatedAt])
  @@index([categoryId, updatedAt])
  @@index([subCategoryId, updatedAt])
}

model InventoryLog {
  id        String   @id @default(cuid())
  productId String
  action    String
  qtyChange Int
  qtyAfter  Int
  note      String?
  source    String   @default("admin")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, createdAt])
}

model CalendarEvent {
  id                  String    @id @default(cuid())
  title               String
  eventType           EventType @default(OTHER)
  eventDate           DateTime
  endDate             DateTime?
  description         String?
  suggestedCategories String[]
  suggestedOccasion   String?
  messagingTheme      String?
  messagingNotes      String?
  isRecurring         Boolean   @default(false)
  recurrenceRule      String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([eventDate])
  @@index([eventType])
}

model BrandStrategyConfig {
  id                String   @id @default(cuid())
  brandName         String   @default("rgjdass Couture")
  tone              String   @default("Royal South Indian Heritage & Modern Luxury")
  brandKeywords     String[]
  whatsappSignature String
  instagramHashtags String
  updatedAt         DateTime @updatedAt
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  phone         String?         @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String          @default("customer")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  orders        CustomerOrder[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GarmentTemplate {
  id                  String           @id @default(cuid())
  name                String
  slug                String           @unique
  tagline             String?
  coverImage          String?
  description         String?
  systemPrompt        String?
  negativePrompt      String?
  cameraSettings      String?
  isActive            Boolean          @default(true)
  sortOrder           Int              @default(0)
  allowModelSelection Boolean          @default(true)
  defaultModelId      String?
  allowedModelIds     Json?
  garmentType         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  orders              CustomerOrder[]
  imageSlots          ImageSlot[]
  poses               PoseTemplate[]
  customOptions       TemplateOption[]
}

model ImageSlot {
  id             String          @id @default(cuid())
  templateId     String
  name           String
  description    String?
  sortOrder      Int             @default(0)
  isRequired     Boolean         @default(true)
  sampleImageUrl String?
  template       GarmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TemplateOption {
  id         String          @id @default(cuid())
  templateId String
  label      String
  optionType String          @default("radio")
  choices    Json
  sortOrder  Int             @default(0)
  template   GarmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model PoseTemplate {
  id            String          @id @default(cuid())
  templateId    String
  name          String
  description   String?
  promptSnippet String
  purpose       String?
  fabricFocus   String?
  previewImage  String?
  category      String          @default("standing")
  sortOrder     Int             @default(0)
  template      GarmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model AIModel {
  id           String   @id @default(cuid())
  name         String
  tagline      String?
  imageUrl     String?
  skinTone     String?
  features     String?
  promptAnchor String
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StudioConfig {
  id                    String   @id @default("global_studio_config")
  selectedEngine        String   @default("gpt-image-2-5-sunburst-image-to-image")
  defaultResolution     String   @default("4k")
  defaultAspectRatio    String   @default("3:4")
  defaultModelPersonaId String?
  globalSystemPrompt    String?
  globalNegativePrompt  String?
  updatedAt             DateTime @updatedAt
}

model KieModel {
  id             String   @id @default(cuid())
  displayName    String
  modelId        String   @unique
  isImageToImage Boolean  @default(true)
  description    String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isDefault])
  @@index([isActive])
}

model CustomerOrder {
  id              String          @id @default(cuid())
  userId          String
  templateId      String
  productName     String?
  stockCode       String?
  description     String?
  uploadedImages  Json?
  icp             String?
  occasion        String?
  fabricType      String?
  selectedModelId String?
  selectedOptions Json?
  aspectRatio     String?         @default("3:4")
  generatedImages Json?
  captions        Json?
  status          String          @default("draft")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  template        GarmentTemplate @relation(fields: [templateId], references: [id])
  user            User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([templateId])
  @@index([status])
  @@index([userId, createdAt])
  @@index([templateId, createdAt])
}

enum StockStatus {
  ACTIVE
  BILLED
  ARCHIVED
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
  DRAFT
}

enum EventType {
  KITTY_PARTY
  PARENT_TEACHER_MEET
  FESTIVAL
  WEDDING
  BIRTHDAY
  ANNIVERSARY
  OFFICE_EVENT
  PUJA_CEREMONY
  FAMILY_FUNCTION
  OTHER
}
